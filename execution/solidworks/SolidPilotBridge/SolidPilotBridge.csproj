<?xml version="1.0" encoding="utf-8"?>
<!-- SolidPilot Bridge: a small in-process SolidWorks add-in. It gives the (out-of-process) execution layer things only code running INSIDE
     SolidWorks can do safely: run on SolidWorks' own UI thread, see command / dialog events, and later host UI helpers.
     Design inspired by AngelSix's SolidDna (MIT) - https://github.com/angelsix/solidworks-api - no code is copied.
     Classic-format project (same as SolidworksExecution) because only the .NET Framework toolchain (VS MSBuild) is installed here. -->
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <ProjectGuid>{B7C1D2E3-4F50-4A61-8B72-9C0D1E2F3A44}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>SolidPilot.Bridge</RootNamespace>
    <AssemblyName>SolidPilotBridge</AssemblyName>
    <!-- Only the 4.5.2 targeting pack is installed on this machine; the output runs on the 4.8 runtime SolidWorks 2026 loads. Retarget to v4.8 once the 4.8 Developer Pack is installed. -->
    <TargetFrameworkVersion>v4.5.2</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <LangVersion>9.0</LangVersion>
    <SwRedist Condition="'$(SwRedist)' == ''">C:\Program Files\Dassault Systemes\SOLIDWORKS 3DEXPERIENCE R2026x\SOLIDWORKS\api\redist</SwRedist>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|x64' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|x64' ">
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="UIAutomationClient" />
    <Reference Include="UIAutomationTypes" />
    <Reference Include="WindowsBase" />
    <!-- Private=True: the SolidWorks interop assemblies are NOT in the GAC on this machine, so they are copied next to the add-in DLL (the CodeBase folder is the probing path). -->
    <Reference Include="SolidWorks.Interop.sldworks"><HintPath>$(SwRedist)\SolidWorks.Interop.sldworks.dll</HintPath><Private>True</Private><EmbedInteropTypes>False</EmbedInteropTypes></Reference>
    <Reference Include="SolidWorks.Interop.swconst"><HintPath>$(SwRedist)\SolidWorks.Interop.swconst.dll</HintPath><Private>True</Private><EmbedInteropTypes>False</EmbedInteropTypes></Reference>
    <Reference Include="SolidWorks.Interop.swpublished"><HintPath>$(SwRedist)\SolidWorks.Interop.swpublished.dll</HintPath><Private>True</Private><EmbedInteropTypes>False</EmbedInteropTypes></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="BridgeAddin.cs" />
    <Compile Include="BridgeEvents.cs" />
    <Compile Include="BridgeLog.cs" />
    <Compile Include="Dialogs.cs" />
    <Compile Include="HttpFacade.cs" />
    <Compile Include="PipeServer.cs" />
    <Compile Include="ScriptRunner.cs" />
    <Compile Include="Snapshots.cs" />
    <Compile Include="ToolGate.cs" />
    <Compile Include="ToolsContract.cs" />
    <Compile Include="ToolsLoader.cs" />
    <Compile Include="UiThread.cs" />
    <Compile Include="WindowProbe.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
